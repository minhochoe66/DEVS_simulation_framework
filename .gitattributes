# Normalise line endings: LF in the repository, native in the working tree.
* text=auto

# Source and configuration
*.py    text diff=python
*.md    text
*.json  text
*.cff   text
*.txt   text

# Binary assets — never diffed or line-ending converted
*.png   binary
*.jpg   binary
*.pdf   binary
*.docx  binary
*.pyc   binary
